# ---------------------------------------------------------------------------
# Environment variables for the Gift Profile app.
# Copy this file to .env.local and fill in real values. Never commit .env.local.
# ---------------------------------------------------------------------------

# Supabase project settings (Project Settings > API in the Supabase dashboard).
# Safe to expose to the browser — used by the client-side Supabase SDK.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER-ONLY. Bypasses Row Level Security. Never import this into a client
# component or any code bundled for the browser. Server (route handlers,
# server actions, server components) use only.
SUPABASE_SERVICE_ROLE_KEY=

# SERVER-ONLY. Used to call the Anthropic API for the gift-picking assistant.
# Never import this into a client component or any code bundled for the browser.
ANTHROPIC_API_KEY=

# Which Anthropic model the AI assistant should call, e.g. claude-sonnet-5.
ANTHROPIC_MODEL=

# Simple daily rate limits for the AI assistant, to keep usage free and abuse-resistant.
AI_DAILY_USER_LIMIT=
AI_DAILY_GUEST_LIMIT=

# Public site URL, used to build the shareable profile links
# (https://.../u/[slug]) and Supabase auth email redirect links
# (confirmation, password reset). Use http://localhost:3000 for local dev.
NEXT_PUBLIC_SITE_URL=

# SERVER-ONLY. Used to send the daily "finish your wishlist" reminder email
# via Resend's API. Never import this into a client component or any code
# bundled for the browser.
RESEND_API_KEY=

# The "from" address reminder emails are sent as. Resend's shared test
# sender (onboarding@resend.dev) works until a custom domain is verified,
# but can only deliver to your own Resend account email until then.
RESEND_FROM_EMAIL=

# SERVER-ONLY. Shared secret the daily reminder cron job presents as a
# bearer token so /api/cron/send-wishlist-nudges can't be triggered by
# anyone else. Generate a long random value — it isn't tied to any account.
CRON_SECRET=
